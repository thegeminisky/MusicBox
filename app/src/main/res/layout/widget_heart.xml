<?xml version="1.0" encoding="utf-8"?>
<!--
  1×1 桌面小组件。桌面格子是「窄而高」的（本机 4 列时约 66×85dp），
  底板直接铺满会成长方形，所以这里放一块正方形卡片居中：
  尺寸在运行期按格子短边再算一次（见 HeartWidget），这里的 60dp 只是老系统的兜底。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetHeartRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widgetHeartTile"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_widget_heart">

        <ImageView
            android:id="@+id/widgetHeartIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_heart_label"
            android:src="@drawable/ic_heart" />
    </FrameLayout>
</FrameLayout>
