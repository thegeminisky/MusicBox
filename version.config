# MusicBox version policy
#
# MAJOR and MINOR are decided by the owner.
# PATCH is computed automatically at build time as the number of commits
# since BASE_COMMIT (i.e. "the Nth commit of this MINOR line").
#
# When bumping MAJOR or MINOR, set BASE_COMMIT to the current HEAD so that
# PATCH restarts at 0. Built APKs then read 1.2.0, 1.2.1, 1.2.2 ...
#
# BASE_COMMIT=ROOT means "count from the first commit of this repository".
# PATCH = (total commits on HEAD) - 1, so the initial commit is 1.2.0.
# History was reset on 2026-11-09 to purge credentials from old commits.
MAJOR=1
MINOR=2
BASE_COMMIT=ROOT
