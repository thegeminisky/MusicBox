<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.mbox.music.TopTabs
        android:id="@+id/topTabs"
        android:layout_width="match_parent"
        android:layout_height="76dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_weight="1"
            android:text="缓存管理"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="30dp">

            <!-- ==================== 占用 ==================== -->
            <TextView
                style="@style/SectionTitle"
                android:text="存储占用" />

            <LinearLayout
                style="@style/SectionCard"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="共占用 0 B"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_bar"
                    android:clipToOutline="true"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/segAudio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#E5484D" />

                    <View
                        android:id="@+id/segCover"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#E0A03A" />

                    <View
                        android:id="@+id/segOther"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#4A5160" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/bg_dot_red" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="歌曲"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAudioSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 B"
                        android:textColor="@color/text"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/bg_dot_yellow" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="封面"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCoverSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 B"
                        android:textColor="@color/text"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/bg_dot_gray" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="其他数据"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvOtherSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 B"
                        android:textColor="@color/text"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCacheCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="已缓存 0 首"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ==================== 缓存策略 ==================== -->
            <TextView
                style="@style/SectionTitle"
                android:text="缓存策略" />

            <LinearLayout
                style="@style/SectionCard"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowPreload"
                    style="@style/SettingRow"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="预载下一首" />

                        <TextView
                            style="@style/RowSub"
                            android:text="播放时顺便把下一首也存到本地" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swPreload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="空间上限" />

                        <TextView
                            android:id="@+id/tvSizeValue"
                            style="@style/RowValue"
                            android:text="2 GB" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="7"
                        android:progress="3"
                        android:progressBackgroundTint="@color/line"
                        android:progressTint="@color/primary"
                        android:splitTrack="false"
                        android:thumbTint="@color/primary" />

                    <!-- 刻度与 SeekBar 的 8 档一一对应；中间各档由代码按 thumb 位置精确对齐 -->
                    <LinearLayout
                        android:id="@+id/scaleRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tick0"
                            style="@style/ScaleTick"
                            android:gravity="start"
                            android:text="0.5G" />

                        <TextView
                            android:id="@+id/tick1"
                            style="@style/ScaleTick"
                            android:gravity="center"
                            android:text="1G" />

                        <TextView
                            android:id="@+id/tick2"
                            style="@style/ScaleTick"
                            android:gravity="center"
                            android:text="1.5G" />

                        <TextView
                            android:id="@+id/tick3"
                            style="@style/ScaleTick"
                            android:gravity="center"
                            android:text="2G" />

                        <TextView
                            android:id="@+id/tick4"
                            style="@style/ScaleTick"
                            android:gravity="center"
                            android:text="5G" />

                        <TextView
                            android:id="@+id/tick5"
                            style="@style/ScaleTick"
                            android:gravity="center"
                            android:text="8G" />

                        <TextView
                            android:id="@+id/tick6"
                            style="@style/ScaleTick"
                            android:gravity="center"
                            android:text="10G" />

                        <TextView
                            android:id="@+id/tick7"
                            style="@style/ScaleTick"
                            android:gravity="end"
                            android:text="20G" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="歌曲数上限" />

                        <TextView
                            style="@style/RowSub"
                            android:text="0 表示不限制" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etSongs"
                        android:layout_width="92dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="5"
                        android:text="0"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="清空全部缓存"
                android:textColor="#C9565C"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
