<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="104dp">

            <!-- ======================== 账号 ======================== -->
            <TextView
                style="@style/SectionTitle"
                android:text="账号" />

            <LinearLayout
                android:id="@+id/cardAccount"
                style="@style/SectionCard"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_avatar"
                    android:clipToOutline="true"
                    android:contentDescription="头像"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tvAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="未登录"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvVip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/rowSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="切换账号"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>



            <!-- ======================== 播放 ======================== -->
            <TextView
                style="@style/SectionTitle"
                android:text="播放" />

            <LinearLayout
                style="@style/SectionCard"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowLevel"
                    style="@style/SettingRow"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="最高音质" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLevelValue"
                        style="@style/RowValue"
                        android:text="无损" />

                    <TextView
                        style="@style/RowArrow"
                        android:text="›" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowAutoplay"
                    style="@style/SettingRow"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="进入歌单自动播放" />

                        <TextView
                            style="@style/RowSub"
                            android:text="打开日推 / 红心 / 心动后直接开始播放全部" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swAutoplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowAutoScope"
                    style="@style/SettingRow"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="仅限日推 / 心动 / 红心" />

                        <TextView
                            style="@style/RowSub"
                            android:text="关闭后，从任意歌单或榜单进入都会自动播放" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swAutoScope"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowUnplug"
                    style="@style/SettingRow"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="拔出耳机时暂停" />

                        <TextView
                            style="@style/RowSub"
                            android:text="拔掉耳机或断开蓝牙后自动停止播放" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swUnplug"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======================== 后台运行 ======================== -->
            <TextView
                style="@style/SectionTitle"
                android:text="后台运行" />

            <LinearLayout
                style="@style/SectionCard"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowNotify"
                    style="@style/SettingRow"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="通知栏播放控件" />

                        <TextView
                            style="@style/RowSub"
                            android:text="关闭后通知栏不显示，同时失去后台保活" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swNotify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowAutoStart"
                    style="@style/SettingRow"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="自启动白名单" />

                        <TextView
                            style="@style/RowSub"
                            android:text="被系统清理后允许重新拉起" />
                    </LinearLayout>

                    <TextView
                        style="@style/RowArrow"
                        android:text="›" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginRight="18dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowBattery"
                    style="@style/SettingRow"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowTitle"
                            android:text="省电策略 → 无限制" />

                        <TextView
                            style="@style/RowSub"
                            android:text="避免锁屏后限制后台网络与唤醒" />
                    </LinearLayout>

                    <TextView
                        style="@style/RowArrow"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======================== 存储 ======================== -->
            <TextView
                style="@style/SectionTitle"
                android:text="存储" />

            <LinearLayout
                style="@style/SectionCard"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowCache"
                    style="@style/SettingRow"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="缓存管理" />

                    <TextView
                        android:id="@+id/tvCacheSize"
                        style="@style/RowValue"
                        android:text="0 B" />

                    <TextView
                        style="@style/RowArrow"
                        android:text="›" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======================== 关于 ======================== -->
            <TextView
                style="@style/SectionTitle"
                android:text="关于" />

            <LinearLayout
                style="@style/SectionCard"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="信息"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:text="当前版本"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBuildTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text=""
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCommit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text=""
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRepo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textColor="@color/text_faint"
                    android:textSize="12sp" />
            </LinearLayout>

    </LinearLayout>
</ScrollView>
