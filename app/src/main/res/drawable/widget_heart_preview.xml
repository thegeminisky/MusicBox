<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件选择器里的预览图（预览布局只在 Android 12+ 生效，这里给老启动器兜底） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F4595E"
                android:endColor="#DA353B" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <item
        android:width="52dp"
        android:height="52dp"
        android:drawable="@drawable/ic_heart_white"
        android:gravity="center" />
</layer-list>
